# ------------------------------------------------------------------
# NG Learning Path — konfigurasi environment
# Salin ke .env.local untuk pengembangan lokal. Di Vercel, isi lewat
# Project → Settings → Environment Variables. JANGAN commit file .env*.
# ------------------------------------------------------------------

# Nama organisasi yang tampil di footer gambar & aplikasi
NEXT_PUBLIC_ORG_NAME=Inixindo Jogja

# ---------- MODE CLOUD (opsional) ----------
# Tanpa variabel di bawah, aplikasi berjalan dalam MODE LOKAL:
# data sesi tersimpan di browser instruktur, link/QR peserta tidak aktif.

# Upstash Redis — otomatis terisi bila memasang integrasi Upstash dari Vercel Marketplace
# (nama KV_REST_API_* juga dibaca).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Wajib untuk mode cloud: passcode login dashboard instruktur
INSTRUCTOR_PASSCODE=

# Rahasia penanda tangan cookie login (string acak panjang, mis. hasil `openssl rand -hex 32`)
SESSION_SECRET=

# Lama data sesi disimpan di server (hari). Default 180.
RETENTION_DAYS=180

# Untuk pengembangan: simulasi mode cloud tanpa Upstash (data hilang saat server restart)
# STORAGE_DRIVER=memory

# ---------- API INTEGRASI (opsional, mis. n8n) ----------
# Mengaktifkan POST /api/v1/plan dan /api/v1/render. Kosongkan untuk menonaktifkan.
GENERATOR_API_KEY=
